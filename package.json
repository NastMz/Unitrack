{
  "name": "unitrack",
  "version": "1.0.0",
  "private": true,
  "description": "Rutas universitarias de la Universidad de los Llanos en Villavicencio: mapa, horarios y avisos.",
  "license": "MIT",
  "type": "module",
  "scripts": {
